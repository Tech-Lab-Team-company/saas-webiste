# Public frontend origin used for canonical URLs, Open Graph, structured data,
# sitemap entries, payment callbacks, and frontend absolute URLs.
NUXT_PUBLIC_SITE_URL=https://www.example.com
# Backward-compatible build/deployment fallback:
SITE_URL=https://www.example.com

# Optional. Analytics stays disabled when this value is empty.
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
